{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
  "mcp": {
    "fetch": {
      "type": "local",
      "command": ["uvx", "--with", "mcp<2", "mcp-server-fetch"],
      "enabled": true
    },
    "wikidata": {
      "type": "remote",
      "url": "https://wd-mcp.wmcloud.org/mcp/",
      "enabled": true
    }
  }
}
